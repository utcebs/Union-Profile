<?xml version="1.0" encoding="UTF-8"?>
<!--
  Union Trading Co. — IIS configuration for the new site.
  Requires the IIS "URL Rewrite" module: https://www.iis.net/downloads/microsoft/url-rewrite
  HOST-AGNOSTIC: the SAME file works on staging.utc.com.kw AND production utc.com.kw.
    - Old->new redirects use RELATIVE targets, so they stay on whatever host you're testing.
    - HTTPS is forced on the current host (stays on staging when testing).
    - www->non-www canonical only fires for the real production host (www.utc.com.kw).
  Canonical for production = https://utc.com.kw (non-www) — matches the old site.
-->
<configuration>
  <system.webServer>

    <!-- Correct MIME types + default document so clean folder URLs (/about/, /fmcg/ …) serve index.html -->
    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" /><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp4" /><mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <!-- Modest revalidating cache: assets aren't fingerprinted, so keep it short to avoid stale content
           (a longer cache would strand users on old images after an update). 1 day + revalidate. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" cacheControlCustom="must-revalidate" />
    </staticContent>
    <defaultDocument>
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>

    <!-- gzip text compression. Our content is all STATIC files (HTML/CSS/JS), so static compression
         is what matters and is safe to enable here. Dynamic compression is left off: we have no
         dynamic responses, and forcing it on can 500.19 if that module isn't installed/unlocked. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <!-- No directory listing (folders without index.html return 404, not a file list) -->
    <directoryBrowse enabled="false" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- Clickjacking: only this site may frame these pages -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- Don't leak full URLs to third parties (social/CDN) -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Force HTTPS at the browser level. Host-scoped (no includeSubDomains) so it's safe on staging AND prod. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <!-- Limit powerful browser features this static marketing site never uses -->
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <!-- Remove framework fingerprinting header -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Hide the IIS Server version header (info disclosure) — IIS 10+ -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <rewrite>
      <rewriteMaps>
        <!-- OLD path (lowercased, no leading slash)  ->  NEW path (relative, so it stays on the current host). -->
        <rewriteMap name="OldToNew">
          <add key="about-us"            value="/about/" />
          <add key="electric-appliances" value="/union-electronics/" />
          <add key="fmcg"                value="/fmcg/" />
          <add key="cosmetics-perfumes"  value="/aluna/" />
          <add key="fashion"             value="/divisions/" />
          <add key="healthcare-solutions" value="/union-services/" />
          <add key="air-conditioning"    value="/divisions/" />
          <add key="our-stores"          value="/our-stores/" />
          <add key="service-center"      value="/union-services/" />
          <add key="careers"             value="/careers/" />
          <add key="get-in-touch"        value="/home/#contact" />
          <add key="whistleblower"       value="/whistleblower/" />
          <add key="our-divisions"       value="/divisions/" />
          <add key="contact-us"          value="/home/#contact" />
          <add key="privacy-statements"  value="/privacy-policy/" />
          <add key="privacy-statement"   value="/privacy-policy/" />
          <add key="testimonials"        value="/home/" />
          <add key="photo-gallery"       value="/home/" />
          <add key="faq"                 value="/faq/" />
          <add key="sitemap.aspx"        value="/sitemap/" />
        </rewriteMap>
      </rewriteMaps>
      <rules>

        <!-- 1) Force HTTPS on the SAME host (staging stays staging, prod stays prod) -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="^off$" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- 2) Production canonical: www.utc.com.kw -> https://utc.com.kw (does NOT affect staging) -->
        <rule name="www to non-www (production)" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTP_HOST}" pattern="^www\.utc\.com\.kw$" /></conditions>
          <action type="Redirect" url="https://utc.com.kw/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- 3) Old URLs -> new URLs (301, case-insensitive via ToLower; relative target stays on host) -->
        <rule name="Old URL 301 redirects" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions><add input="{OldToNew:{ToLower:{R:1}}}" pattern="(.+)" /></conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- 4) Old homepage "/" -> "/home/" -->
        <rule name="Root to home" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/home/" redirectType="Permanent" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
